# ---------- LLM: NVIDIA (free key at build.nvidia.com → your model → "Generate API Key") ----------
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-xxxxxxxx
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TEMPERATURE=0.3
# Nemotron "thinking" is switched off by default so visitors only see answers. To change:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# Any other OpenAI-compatible provider works by changing the three LLM_ lines
# (Hugging Face: https://router.huggingface.co/v1 · Ollama: http://localhost:11434/v1).

# ---------- Knowledge: Google Drive folder shared "Anyone with the link → Viewer" ----------
# Leave empty to use the local knowledge/ folder. You can also set it from /admin.
DRIVE_FOLDER_URL=
KNOWLEDGE_REFRESH_MINUTES=30

# ---------- Email to you (contact form + chat summaries) ----------
NOTIFY_EMAIL=mahidhara.s@outlook.com
# Option A (easiest): Resend. Sign up at resend.com WITH mahidhara.s@outlook.com, create an API key.
RESEND_API_KEY=
# MAIL_FROM=Portfolio <onboarding@resend.dev>
# Option B: SMTP, e.g. a Gmail account + App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
CHAT_IDLE_MINUTES=10

# ---------- Owner page (/admin) ----------
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---------- Web ----------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=20

# ---------- LangSmith tracing (optional) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ask-mahi

# ---------- Private visitor memory in your Drive (optional; see drive-history/Code.gs) ----------
HISTORY_WEBHOOK_URL=
HISTORY_SECRET=
