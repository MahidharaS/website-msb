# ---------- LLM (any OpenAI-compatible endpoint) ----------
# Hugging Face Inference Providers (free monthly credits with a free HF account):
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=hf_xxx                       # https://huggingface.co/settings/tokens (read + "Inference Providers")
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct       # open-weight; alternatives: meta-llama/Llama-3.1-8B-Instruct, mistralai/Mistral-7B-Instruct-v0.3
# Fully local (no key) with Ollama instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.2

# ---------- Embeddings (runs on CPU inside the container, free) ----------
EMBED_MODEL=BAAI/bge-small-en-v1.5      # 384 dims, matches supabase/schema.sql

# ---------- Supabase (optional; without it an in-memory index is built at startup) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=               # server-side only, never put this in the frontend
SUPABASE_TABLE=documents
SUPABASE_QUERY_FN=match_documents
LOG_CHATS=true

# ---------- LangSmith tracing (optional) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ask-mahi

# ---------- Web ----------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
