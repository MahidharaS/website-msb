# Frontend env (copy to .env.local for localhost; set the same keys in Render/Lovable for the web).
# .env.local is git-ignored, so local values never reach the hosted site.

# URL of the Ask Mahi backend (Hugging Face Space or local uvicorn). Leave empty for offline mode.
VITE_CHAT_API_URL=http://localhost:7860

# Optional: resume URL for self-hosted builds (e.g. /resume.pdf after dropping the file into public/).
VITE_RESUME_URL=
